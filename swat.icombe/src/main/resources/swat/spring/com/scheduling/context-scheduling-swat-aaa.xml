<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- 웹 로그 요약 -->
	<bean id="swatAaaJobDetail"
		class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject" ref="swatAaaScheduling" />
		<property name="targetMethod" value="webLogSummary" />
		<property name="concurrent" value="false" />
	</bean>

	<!-- 웹 로그 요약 트리거 -->
	<bean id="swatAaaTrigger"
		class="org.springframework.scheduling.quartz.SimpleTriggerFactoryBean">
		<property name="jobDetail" ref="swatAaaJobDetail" />
		<property name="startDelay" value="60000" />
		<property name="repeatInterval" value="3600000" />
	</bean>

	<!-- 웹 로그 요약 스케줄러 -->
	<bean id="swatAaaScheduler"
		class="org.springframework.scheduling.quartz.SchedulerFactoryBean">
		<property name="triggers">
			<list>
				<ref bean="swatAaaTrigger" />
			</list>
		</property>
	</bean>
</beans>
